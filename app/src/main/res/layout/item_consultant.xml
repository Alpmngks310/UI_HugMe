<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_input_hugme"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#F4B4C8"
            android:text="👤"
            android:gravity="center"
            android:textSize="30sp"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtConsultantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consultant Name"
                android:textColor="#455A64"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/txtConsultantSpecialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clinical Psychologist"
                android:textColor="#607D8B"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat"
            android:backgroundTint="#F4B4C8"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
