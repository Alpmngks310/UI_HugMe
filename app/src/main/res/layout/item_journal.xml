<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_input_hugme">

        <TextView
            android:id="@+id/txtJournalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Journal Title"
            android:textColor="#455A64"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:id="@+id/txtJournalDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="October 24, 2023"
            android:textColor="#607D8B"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular" />

        <TextView
            android:id="@+id/txtJournalContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Journal content snippet..."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
